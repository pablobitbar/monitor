const uploadZone = document.getElementById('uploadZone');
const fileInput = document.getElementById('fileInput');

uploadZone.addEventListener('click', () => fileInput.click());
uploadZone.addEventListener('dragover', e => {
  e.preventDefault(); uploadZone.classList.add('dragover');
});
uploadZone.addEventListener('dragleave', () => uploadZone.classList.remove('dragover'));
uploadZone.addEventListener('drop', e => {
  e.preventDefault(); uploadZone.classList.remove('dragover');
  processarArquivos(e.dataTransfer.files);
});
fileInput.addEventListener('change', e => processarArquivos(e.target.files));

function processarArquivos(files) {
  const xmlFiles = Array.from(files).filter(f => f.name.toLowerCase().endsWith('.xml'));
  if (!xmlFiles.length) return toast('⚠️ Nenhum arquivo XML encontrado');

  let carregadas = 0, erros = 0;
  const promises = xmlFiles.map(file => new Promise(resolve => {
    const reader = new FileReader();
    reader.onload = e => {
      try {
        const nota = parseXML(e.target.result, file.name);
        if (nota) { notas.push(nota); carregadas++; }
        else erros++;
      } catch(err) { erros++; }
      resolve();
    };
    reader.readAsText(file, 'UTF-8');
  }));

  Promise.all(promises).then(() => {
    const map = new Map();
    const semChave = [];
    notas.forEach(n => {
      const k = String(n.chave || '').replace(/\D/g,'');
      if (k.length === 44) {
        if (!map.has(k)) map.set(k, n);
      } else {
        semChave.push(n);
      }
    });
    notas = [...map.values(), ...semChave];

    toast(`✅ ${carregadas} nota(s) carregada(s)${erros ? ` • ${erros} erro(s)` : ''}`);
    iniciarInterface();
  });
}

/* ==================================================================
   G) INTERFACE
   ================================================================== */
function iniciarInterface() {
  if (!notas.length) return;
  document.getElementById('statsGrid').style.display = 'grid';
  document.getElementById('filters').style.display = 'grid';
  document.getElementById('tableWrapper').style.display = 'block';
  document.getElementById('emptyState').style.display = 'none';

  preencherSelect('filterIndPres',
    [...new Set(notas.map(n => n.indPres).filter(Boolean))], IND_PRES);

  const tps = new Set();
  notas.forEach(n => n.tiposPag.forEach(t => tps.add(t)));
  preencherSelect('filterTpag', [...tps], T_PAG);

  ['filterIndPres','filterTpag','filterTaxa','filterDataIni','filterDataFim',
   'filterBusca','filterValorMin','filterValorMax']
    .forEach(id => {
      const el = document.getElementById(id);
      el.removeEventListener('input', aplicarFiltros);
      el.addEventListener('input', aplicarFiltros);
    });

  aplicarFiltros();
}

function preencherSelect(id, valores, mapa) {
  const sel = document.getElementById(id);
  const atual = sel.value;
  sel.innerHTML = '<option value="">Todos</option>' +
    valores.sort().map(v => `<option value="${v}">${v} - ${mapa[v]||v}</option>`).join('');
  sel.value = atual;
}

function aplicarFiltros() {
  const fIndPres = document.getElementById('filterIndPres').value;
  const fTpag = document.getElementById('filterTpag').value;
  const fTaxa = document.getElementById('filterTaxa').value;
  const fIni = document.getElementById('filterDataIni').value;
  const fFim = document.getElementById('filterDataFim').value;
  const fBusca = document.getElementById('filterBusca').value.toLowerCase().trim();
  const fMin = parseFloat(document.getElementById('filterValorMin').value);
  const fMax = parseFloat(document.getElementById('filterValorMax').value);

  notasFiltradas = notas.filter(n => {
    if (fIndPres && n.indPres !== fIndPres) return false;
    if (fTpag && !n.tiposPag.includes(fTpag)) return false;
    if (fTaxa === 'com' && !n.temTaxa) return false;
    if (fTaxa === 'sem' && n.temTaxa) return false;
    if (fIni && n.data) {
      const d = new Date(fIni + 'T00:00:00');
      if (n.data < d) return false;
    }
    if (fFim && n.data) {
      const d = new Date(fFim + 'T23:59:59');
      if (n.data > d) return false;
    }
    if (!isNaN(fMin) && n.vNF < fMin) return false;
    if (!isNaN(fMax) && n.vNF > fMax) return false;
    if (fBusca) {
      const blob = `${n.nNF} ${n.chave} ${n.xNome} ${n.produtos.map(p=>p.xProd).join(' ')}`.toLowerCase();
      if (!blob.includes(fBusca)) return false;
    }
    return true;
  });

  notasFiltradas.sort((a,b) => (parseInt(a.nNF)||0) - (parseInt(b.nNF)||0));
  renderStats();
  renderTabela();
}

function renderStats() {
  const total = notasFiltradas.length;
  const valorTotal = notasFiltradas.reduce((s,n) => s + n.vNF, 0);
  const totalPagoBruto = notasFiltradas.reduce((s,n) => s + n.totalPagoBruto, 0);
  const comTaxa = notasFiltradas.filter(n => n.temTaxa);
  const semTaxa = notasFiltradas.filter(n => !n.temTaxa);
  const totalTaxa = notasFiltradas.reduce((s,n) => s + n.valorTaxa, 0);

  document.getElementById('statTotalNotas').textContent = total;
  document.getElementById('statTotalNotasSub').textContent = `de ${notas.length} carregada(s)`;
  document.getElementById('statValorTotal').textContent = fmt(valorTotal);
  document.getElementById('statValorTotalSub').textContent = total ? `média ${fmt(valorTotal/total)}` : '—';
  document.getElementById('statTotalPago').textContent = fmt(totalPagoBruto);
  document.getElementById('statTotalPagoSub').textContent = total ? `média ${fmt(totalPagoBruto/total)}` : '—';
  document.getElementById('statComTaxa').textContent = comTaxa.length;
  document.getElementById('statComTaxaSub').textContent = fmt(comTaxa.reduce((s,n)=>s+n.vNF,0));
  document.getElementById('statSemTaxa').textContent = semTaxa.length;
  document.getElementById('statSemTaxaSub').textContent = fmt(semTaxa.reduce((s,n)=>s+n.vNF,0));
  document.getElementById('statTotalTaxa').textContent = fmt(totalTaxa);
}

function renderTabela() {
  const tbody = document.getElementById('tbody');
  if (!notasFiltradas.length) {
    tbody.innerHTML = `<tr><td colspan="14" style="text-align:center;padding:40px;color:var(--muted)">
      Nenhuma nota encontrada com os filtros aplicados
    </td></tr>`;
    return;
  }

  tbody.innerHTML = notasFiltradas.map((n,i) => {
    const indDesc = IND_PRES[n.indPres] || n.indPres || '—';
    const pagDesc = n.tiposPag.map(t => T_PAG[t] || t).join(', ') || '—';
    const taxaBadge = n.temTaxa
      ? '<span class="badge green">Com taxa</span>'
      : '<span class="badge gray">Sem taxa</span>';
    const modBadge = n.modelo === '55'
      ? '<span class="badge warn">NF-e</span>'
      : '<span class="badge blue">NFC-e</span>';
    return `<tr>
      <td>${i+1}</td>
      <td><strong>${n.nNF||'—'}</strong> / ${n.serie||'—'}<br>${modBadge}</td>
      <td>${fmtData(n.dhEmi)}</td>
      <td>${escapeHtml(n.xNome||'—')}<br><small style="color:var(--muted)">${n.cnpj||''}</small></td>
      <td><span class="badge blue">${n.indPres||'—'}</span> ${indDesc}</td>
      <td><span class="badge warn">${n.tiposPag.join(',')||'—'}</span> ${pagDesc}</td>
      <td>${taxaBadge}</td>
      <td>${n.temTaxa ? fmt(n.valorTaxa) : '—'}</td>
      <td>${fmt(n.vDesc)}</td>
      <td><strong>${fmt(n.vNF)}</strong></td>
      <td><strong>${fmt(n.totalPagoBruto)}</strong></td>
      <td>${n.vTroco > 0 ? fmt(n.vTroco) : '—'}</td>
      <td><small style="color:var(--muted);font-family:monospace">${n.chave}</small></td>
      <td><button class="btn-view" data-chave="${n.chave}">👁️ Ver</button></td>
    </tr>`;
  }).join('');

  tbody.querySelectorAll('.btn-view').forEach(btn => {
    btn.addEventListener('click', () => {
      const chave = btn.dataset.chave;
      const idx = notasFiltradas.findIndex(n => n.chave === chave);
      if (idx >= 0) abrirVisualizador(idx);
    });
  });
}

function limparFiltros() {
  ['filterIndPres','filterTpag','filterTaxa','filterDataIni','filterDataFim',
   'filterBusca','filterValorMin','filterValorMax']
    .forEach(id => document.getElementById(id).value = '');
  aplicarFiltros();
}

