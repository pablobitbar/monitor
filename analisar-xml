    }

    const vol = transpBlock.getElementsByTagName('vol')[0];
    if (vol) {
      qVol = vol.getElementsByTagName('qVol')[0]?.textContent?.trim() || '---';
      esp = vol.getElementsByTagName('esp')[0]?.textContent?.trim() || '---';
      marca = vol.getElementsByTagName('marca')[0]?.textContent?.trim() || '---';
      nVol = vol.getElementsByTagName('nVol')[0]?.textContent?.trim() || '---';
      pesoB = formatMoney(vol.getElementsByTagName('pesoB')[0]?.textContent);
