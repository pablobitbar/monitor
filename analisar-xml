<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Analisador de NF-e / NFC-e</title>
<style>
  :root{
    --bg:#0f172a; --card:#1e293b; --card2:#273449;
    --accent:#38bdf8; --accent2:#22c55e; --danger:#ef4444; --warn:#f59e0b;
    --text:#e2e8f0; --muted:#94a3b8; --border:#334155;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{
    font-family:'Segoe UI',system-ui,-apple-system,sans-serif;
    background:linear-gradient(135deg,#0f172a 0%,#1e293b 100%);
    color:var(--text);min-height:100vh;padding:24px;
  }
  .container{max-width:1400px;margin:0 auto}

  header{text-align:center;margin-bottom:32px}
  header h1{
    font-size:2.2rem;font-weight:700;
    background:linear-gradient(90deg,#38bdf8,#22c55e);
    -webkit-background-clip:text;-webkit-text-fill-color:transparent;
    background-clip:text;margin-bottom:8px;
  }
  header p{color:var(--muted);font-size:.95rem}

  .upload-zone{
    background:var(--card);border:2px dashed var(--border);
    border-radius:16px;padding:48px 24px;text-align:center;
    cursor:pointer;transition:all .3s;margin-bottom:24px;
  }
  .upload-zone:hover,.upload-zone.dragover{
    border-color:var(--accent);background:var(--card2);transform:translateY(-2px);
  }
  .upload-zone .icon{font-size:3rem;margin-bottom:12px}
  .upload-zone h3{font-size:1.2rem;margin-bottom:8px}
  .upload-zone p{color:var(--muted);font-size:.9rem}
  #fileInput{display:none}

  .stats-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-bottom:24px}
  .stat-card{background:var(--card);border-radius:12px;padding:20px;border:1px solid var(--border);position:relative;overflow:hidden}
  .stat-card::before{content:'';position:absolute;top:0;left:0;width:4px;height:100%;background:var(--accent)}
  .stat-card.green::before{background:var(--accent2)}
  .stat-card.warn::before{background:var(--warn)}
  .stat-card.red::before{background:var(--danger)}
  .stat-card .label{color:var(--muted);font-size:.8rem;text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px}
  .stat-card .value{font-size:1.6rem;font-weight:700}
  .stat-card .sub{color:var(--muted);font-size:.8rem;margin-top:4px}

  .filters{
    background:var(--card);border-radius:12px;padding:20px;margin-bottom:20px;
    border:1px solid var(--border);
    display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
    gap:16px;align-items:end;
  }
  .filter-group{display:flex;flex-direction:column;gap:6px}
  .filter-group label{font-size:.8rem;color:var(--muted);text-transform:uppercase;letter-spacing:.5px}
  .filter-group select,.filter-group input{
    background:var(--card2);border:1px solid var(--border);color:var(--text);
    padding:10px 12px;border-radius:8px;font-size:.9rem;outline:none;transition:border .2s;
  }
  .filter-group select:focus,.filter-group input:focus{border-color:var(--accent)}

  .btn{
    background:var(--accent);color:#0f172a;border:none;padding:10px 20px;
    border-radius:8px;cursor:pointer;font-weight:600;font-size:.9rem;transition:all .2s;
  }
  .btn:hover{background:#0ea5e9;transform:translateY(-1px)}
  .btn.secondary{background:var(--card2);color:var(--text);border:1px solid var(--border)}
  .btn.secondary:hover{background:var(--border)}
  .btn.green{background:var(--accent2);color:#0f172a}
  .btn.green:hover{background:#16a34a}

  .table-wrapper{background:var(--card);border-radius:12px;overflow:hidden;border:1px solid var(--border)}
  .table-header{
    padding:16px 20px;display:flex;justify-content:space-between;align-items:center;
    border-bottom:1px solid var(--border);flex-wrap:wrap;gap:12px;
  }
  .table-header h2{font-size:1.1rem}
  .table-header .actions{display:flex;gap:8px;flex-wrap:wrap}
  table{width:100%;border-collapse:collapse;font-size:.85rem}
  thead{background:var(--card2);position:sticky;top:0;z-index:10}
  th{text-align:left;padding:12px 14px;color:var(--muted);font-weight:600;font-size:.75rem;text-transform:uppercase;letter-spacing:.5px;white-space:nowrap}
  td{padding:12px 14px;border-top:1px solid var(--border)}
  tbody tr:hover{background:var(--card2)}
  .badge{display:inline-block;padding:3px 10px;border-radius:20px;font-size:.75rem;font-weight:600}
  .badge.blue{background:rgba(56,189,248,.15);color:#38bdf8}
  .badge.green{background:rgba(34,197,94,.15);color:#22c55e}
  .badge.red{background:rgba(239,68,68,.15);color:#ef4444}
  .badge.warn{background:rgba(245,158,11,.15);color:#f59e0b}
  .badge.gray{background:rgba(148,163,184,.15);color:#94a3b8}

  .btn-view{
    background:transparent;border:1px solid var(--accent);color:var(--accent);
    padding:5px 10px;border-radius:6px;cursor:pointer;font-size:.75rem;font-weight:600;
    transition:all .15s;white-space:nowrap;
  }
  .btn-view:hover{background:var(--accent);color:#0f172a}

  .empty{text-align:center;padding:60px 20px;color:var(--muted)}
  .empty .icon{font-size:4rem;margin-bottom:16px;opacity:.4}

  .toast{
    position:fixed;bottom:24px;right:24px;background:var(--card2);
    padding:14px 20px;border-radius:10px;border:1px solid var(--border);
    box-shadow:0 10px 30px rgba(0,0,0,.4);
    transform:translateY(100px);opacity:0;transition:all .3s;z-index:3000;
  }
  .toast.show{transform:translateY(0);opacity:1}

  @media(max-width:768px){
    body{padding:12px}
    header h1{font-size:1.6rem}
    .stats-grid{grid-template-columns:1fr 1fr}
    .filters{grid-template-columns:1fr}
    table{font-size:.75rem}
    th,td{padding:8px 10px}
  }

  /* ============== MODAL VISUALIZADOR ============== */
  #viewerModal{
    display:none;position:fixed;inset:0;z-index:2000;
    background:rgba(0,0,0,.75);backdrop-filter:blur(3px);
  }
  #viewerModal.show{display:flex;flex-direction:column}
  #viewerModal .modal-header{
    background:#1f2937;color:#e5e7eb;padding:10px 16px;
    display:flex;align-items:center;gap:10px;flex-wrap:wrap;
    border-bottom:1px solid #111827;
  }
  #viewerModal .modal-header .titulo{font-weight:700;font-size:14px;margin-right:auto}
  #viewerModal .modal-header .info{font-size:12px;color:#9ca3af}
  #viewerModal .modal-header button{
    background:#2563eb;color:#fff;border:none;padding:7px 14px;
    border-radius:6px;cursor:pointer;font-size:12px;font-weight:600;
    transition:background .15s;
  }
  #viewerModal .modal-header button:hover{background:#1d4ed8}
  #viewerModal .modal-header button:disabled{background:#6b7280;cursor:not-allowed}
  #viewerModal .modal-header button.secondary{background:#374151;color:#e5e7eb}
  #viewerModal .modal-header button.secondary:hover{background:#4b5563}
  #viewerModal .modal-header button.close{background:#ef4444}
  #viewerModal .modal-header button.close:hover{background:#dc2626}

  #viewerModal .modal-body{
    flex:1;overflow:auto;background:#e5e7eb;padding:20px;
    display:flex;justify-content:center;
  }
  #viewerModal .viewer-paper{
    background:#fff;box-shadow:0 4px 20px rgba(0,0,0,.3);
    border-radius:4px;
    align-self:flex-start;
  }

  /* ============================================================
     ESTILOS DO VISUALIZADOR — NFC-e (cupom 300px)
     ============================================================ */
  #viewerPaper.nfce-paper{
    width: 300px;
    padding: 15px 12px;
    font-family: Arial, sans-serif;
    font-size: 10.5px;
    color: #000;
  }
  #viewerPaper.nfce-paper *{box-sizing:border-box;}

  .nfce-center { text-align: center; margin-bottom: 2px; }
  .nfce-row { display: flex; justify-content: space-between; margin-bottom: 3px; }
  .nfce-divider { border-top: 1px dashed #000; margin: 8px 0; width: 100%; }

  .font-bold { font-weight: bold; }
  .font-large { font-size: 12px; }
  .text-muted { color: #555; }

  .nfce-table { width: 100%; border-collapse: collapse; font-size: 9.5px; margin: 6px 0; table-layout: fixed; }
  .nfce-table th { border-bottom: 1px solid #000; padding: 3px 0; font-weight: bold; font-size: 10px; }
  .nfce-table td { padding: 2px 0; vertical-align: middle; }

  .nfce-item-desc {
    padding-top: 6px !important;
    font-weight: bold;
    font-size: 10px;
    word-break: break-word;
    letter-spacing: -0.1px;
    line-height: 11px;
  }

  /* ============================================================
     ESTILOS DO VISUALIZADOR — NF-e (DANFE A4 790px)
     ============================================================ */
  #viewerPaper.nfe-paper{
    width: 790px;
    max-width: 100%;
    padding: 10px;
    font-family: Arial, sans-serif;
    color: #000;
  }
  #viewerPaper.nfe-paper *{box-sizing:border-box;}

  #viewerPaper.nfe-paper .danfe-block { border: 1px solid #000; width: 100%; background: #fff; margin-top: -1px; }
  #viewerPaper.nfe-paper .danfe-section-title { font-weight: bold; font-size: 9px; margin: 8px 0 2px 2px; }
  #viewerPaper.nfe-paper .danfe-label { font-size: 7px; font-weight: normal; color: #333; text-transform: uppercase; margin-bottom: 1px; }
  #viewerPaper.nfe-paper .danfe-value { font-size: 10px; color: #000; min-height: 12px; font-weight: bold; text-transform: uppercase; }
  #viewerPaper.nfe-paper .danfe-value-number { font-size: 10px; color: #000; text-align: right; padding-right: 4px; }
  #viewerPaper.nfe-paper .danfe-text { font-size: 10px; line-height: 1.2; }

  #viewerPaper.nfe-paper .danfe-table { width: 100%; border-collapse: collapse; margin-top: 2px; border: 1px solid #000; }
  #viewerPaper.nfe-paper .danfe-table th { border: 1px solid #000; background: #f2f2f2; font-size: 7px; font-weight: bold; padding: 4px 2px; text-align: center; }
  #viewerPaper.nfe-paper .danfe-table td { border: 1px solid #000; font-size: 9px; padding: 3px 4px; vertical-align: middle; }

  /* ============== IMPRESSÃO ============== */
  @media print{
    body{background:#fff;padding:0}
    .container,.toast{display:none!important}
    #viewerModal{position:static;background:#fff;display:block!important;backdrop-filter:none}
    #viewerModal .modal-header{display:none!important}
    #viewerModal .modal-body{background:#fff;padding:0;display:block;overflow:visible}
    #viewerModal .viewer-paper{
      box-shadow:none;
      border-radius:0;
      max-width:100%;
      padding:6mm;
    }
    #viewerPaper.nfce-paper{
      width: 80mm;
      padding: 0;
      margin: 0 auto;
    }
    #viewerPaper.nfe-paper{
      width: 100%;
      padding: 0;
      margin: 0 auto;
    }
  }
</style>
</head>
<body>
<div class="container">

  <header>
    <h1>📊 Analisador de NF-e / NFC-e</h1>
    <p>Carregue seus XMLs, filtre os dados e visualize cada nota</p>
  </header>

  <div class="upload-zone" id="uploadZone">
    <div class="icon">📁</div>
    <h3>Arraste seus arquivos XML aqui</h3>
    <p>ou clique para selecionar (múltiplos arquivos permitidos)</p>
    <input type="file" id="fileInput" multiple accept=".xml">
  </div>

  <div class="stats-grid" id="statsGrid" style="display:none">
    <div class="stat-card">
      <div class="label">Total de Notas</div>
      <div class="value" id="statTotalNotas">0</div>
      <div class="sub" id="statTotalNotasSub">—</div>
    </div>
    <div class="stat-card green">
      <div class="label">💰 Valor Total (vNF)</div>
      <div class="value" id="statValorTotal">R$ 0,00</div>
      <div class="sub" id="statValorTotalSub">—</div>
    </div>
    <div class="stat-card warn">
      <div class="label">💵 Total Pago (bruto)</div>
      <div class="value" id="statTotalPago">R$ 0,00</div>
      <div class="sub" id="statTotalPagoSub">—</div>
    </div>
    <div class="stat-card">
      <div class="label">Com Taxa de Entrega</div>
      <div class="value" id="statComTaxa">0</div>
      <div class="sub" id="statComTaxaSub">R$ 0,00</div>
    </div>
    <div class="stat-card red">
      <div class="label">Sem Taxa de Entrega</div>
      <div class="value" id="statSemTaxa">0</div>
      <div class="sub" id="statSemTaxaSub">R$ 0,00</div>
    </div>
    <div class="stat-card">
      <div class="label">Total Taxas de Entrega</div>
      <div class="value" id="statTotalTaxa">R$ 0,00</div>
      <div class="sub">soma do item 9998</div>
    </div>
  </div>

  <div class="filters" id="filters" style="display:none">
    <div class="filter-group">
      <label>indPres</label>
      <select id="filterIndPres"><option value="">Todos</option></select>
    </div>
    <div class="filter-group">
      <label>Tipo de Pagamento</label>
      <select id="filterTpag"><option value="">Todos</option></select>
    </div>
    <div class="filter-group">
      <label>Taxa de Entrega</label>
      <select id="filterTaxa">
        <option value="">Todas</option>
        <option value="com">Com taxa</option>
        <option value="sem">Sem taxa</option>
      </select>
    </div>
    <div class="filter-group">
      <label>Data Inicial</label>
      <input type="date" id="filterDataIni">
    </div>
    <div class="filter-group">
      <label>Data Final</label>
      <input type="date" id="filterDataFim">
    </div>
    <div class="filter-group">
      <label>Buscar</label>
      <input type="text" id="filterBusca" placeholder="nº, chave, produto...">
    </div>
    <div class="filter-group">
      <label>Valor Mínimo (R$)</label>
      <input type="number" id="filterValorMin" step="0.01">
    </div>
    <div class="filter-group">
      <label>Valor Máximo (R$)</label>
      <input type="number" id="filterValorMax" step="0.01">
    </div>
    <div class="filter-group">
      <button class="btn secondary" onclick="limparFiltros()">🧹 Limpar Filtros</button>
    </div>
  </div>

  <div class="table-wrapper" id="tableWrapper" style="display:none">
    <div class="table-header">
      <h2>📋 Notas Fiscais</h2>
      <div class="actions">
        <button class="btn green" onclick="exportarPDF()">📄 Exportar PDF</button>
        <button class="btn secondary" onclick="exportarCSV()">⬇️ Exportar CSV</button>
      </div>
    </div>
    <div style="overflow-x:auto">
      <table id="tabela">
        <thead>
          <tr>
            <th>#</th>
            <th>Nº / Série</th>
            <th>Data Emissão</th>
            <th>Emitente</th>
            <th>indPres</th>
            <th>Pagamento</th>
            <th>Taxa Entrega</th>
            <th>Valor Taxa</th>
            <th>Desconto</th>
            <th>💰 Valor Total (vNF)</th>
            <th>💵 Total Pago</th>
            <th>Troco</th>
            <th>Chave</th>
            <th>Ação</th>
          </tr>
        </thead>
        <tbody id="tbody"></tbody>
      </table>
    </div>
  </div>

  <div class="empty" id="emptyState">
    <div class="icon">📭</div>
    <h3>Nenhuma nota carregada</h3>
    <p>Carregue arquivos XML para começar a análise</p>
  </div>
</div>

<!-- ============ MODAL VISUALIZADOR ============ -->
<div id="viewerModal">
  <div class="modal-header">
    <button id="btnPrev" class="secondary" disabled>◀ Anterior</button>
    <button id="btnNext" class="secondary" disabled>Próxima ▶</button>
    <span class="titulo" id="modalTitulo">Visualizador</span>
    <span class="info" id="modalInfo"></span>
    <button id="btnPrintModal">🖨️ Imprimir / PDF</button>
    <button class="close" id="btnCloseModal">✕ Fechar</button>
  </div>
  <div class="modal-body">
    <div class="viewer-paper" id="viewerPaper"></div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
/* ==================================================================
   A) ESTADO
   ================================================================== */
let notas = [];
let notasFiltradas = [];
let indiceVisualizando = -1;

const IND_PRES = {
  '0':'Não se aplica','1':'Operação presencial','2':'Não presencial - Internet',
  '3':'Não presencial - Teleatendimento','4':'NFC-e entrega a domicílio',
  '5':'Presencial fora do estabelecimento','9':'Não presencial - Outros'
};
const T_PAG = {
  '01':'Dinheiro','02':'Cheque','03':'Cartão de Crédito','04':'Cartão de Débito',
  '05':'Crédito Loja','10':'Vale Alimentação','11':'Vale Refeição','12':'Vale Presente',
  '13':'Vale Combustível','14':'Duplicata Mercantil','15':'Boleto Bancário',
  '16':'Depósito Bancário','17':'PIX','18':'Transferência bancária',
  '19':'Programa de fidelidade','90':'Sem pagamento','99':'Outros'
};

/* ==================================================================
   B) HELPERS GERAIS
   ================================================================== */
function escapeHtml(str) {
  if (!str) return '';
  return String(str).replace(/[&<>"']/g, m => ({
    '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
  })[m]);
}
function formatDocLocal(doc) {
  if (!doc) return '';
  const d = String(doc).replace(/\D/g, '');
  if (d.length === 14) return d.replace(/(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})/, '$1.$2.$3/$4-$5');
  if (d.length === 11) return d.replace(/(\d{3})(\d{3})(\d{3})(\d{2})/, '$1.$2.$3-$4');
  return doc;
}
function formatCEP(cep) {
  if (!cep) return '';
  const c = String(cep).replace(/\D/g, '');
  if (c.length === 8) return c.replace(/(\d{5})(\d{3})/, '$1-$2');
  return cep;
}
function formatNumeroNota(num) {
  if (!num) return '000.000.000';
  const n = String(num).padStart(9, '0');
  return n.replace(/(\d{3})(\d{3})(\d{3})/, '$1.$2.$3');
}
function formatDataHora(dt) {
  if (!dt) return '---';
  try {
    const datePart = dt.split('T')[0];
    const timePart = dt.split('T')[1] ? dt.split('T')[1].substring(0,8) : '';
    const parts = datePart.split('-');
    if (parts.length === 3) return `${parts[2]}/${parts[1]}/${parts[0]} ${timePart}`.trim();
  } catch(e){}
  return dt;
}
function formatDataSimples(dt) {
  if (!dt) return '---';
  const parts = dt.split('-');
  if (parts.length === 3) return `${parts[2]}/${parts[1]}/${parts[0]}`;
  return dt;
}
function formatMoney(v) {
  if (v === undefined || v === null || v === '') return '0,00';
  const s = String(v).trim().replace(',', '.');
  const n = parseFloat(s);
  if (isNaN(n)) return escapeHtml(String(v));
  return n.toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}
function formatKey(key) {
  if (!key) return '';
  const k = String(key).replace(/\s+/g, '');
  return k.match(/.{1,4}/g)?.join(' ') || k;
}
function fmt(v) {
  return 'R$ ' + (v||0).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2});
}
function fmtData(iso) {
  if (!iso) return '—';
  try {
    const d = new Date(iso);
    return d.toLocaleDateString('pt-BR') + ' ' +
           d.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});
  } catch { return iso; }
}

/* ==================================================================
   C) RENDERIZADOR NFC-e — Layout cupom (viewer.js)
   ================================================================== */
function renderNFCe(xmlText) {
  const parser = new DOMParser();
  const xml = parser.parseFromString(xmlText, 'application/xml');
  if (xml.getElementsByTagName('parsererror').length > 0) {
    return '<div class="empty"><div class="icon">⚠️</div><div>Erro ao ler XML</div></div>';
  }

  const get = (tagName, ctx = xml) => {
    const els = ctx.getElementsByTagName(tagName);
    return els.length > 0 ? els[0].textContent.trim() : '';
  };
  const getTotalValue = (tagName) => {
    const totalBlock = xml.getElementsByTagName('total')[0];
    if (totalBlock) {
      const icmsTot = totalBlock.getElementsByTagName('ICMSTot')[0];
      if (icmsTot) {
        const el = icmsTot.getElementsByTagName(tagName)[0];
        return el ? el.textContent.trim() : '0.00';
      }
    }
    return '0.00';
  };

  // --- Emitente ---
  const xNome = get('xNome') || '---';
  const xFant = get('xFant') || '';
  const CNPJ = formatDocLocal(get('CNPJ'));
  const IE = get('IE') || '---';
  const xLgr = get('xLgr') || '';
  const nro = get('nro') || '';
  const xBairro = get('xBairro') || '';
  const xMun = get('xMun') || '';
  const UF = get('UF') || '';

  // --- Nota ---
  const chNFe = get('chNFe') ||
    xml.getElementsByTagName('infNFe')[0]?.getAttribute('Id')?.replace('NFe','') || '';
  const nNF = get('nNF') || '000.000.000';
  const serie = get('serie') || '1';
  const dhEmi = formatDataHora(get('dhEmi'));
  const nProt = get('nProt') || '---';
  const dhRecbto = formatDataHora(get('dhRecbto'));

  // --- Destinatário ---
  const destBlock = xml.getElementsByTagName('dest')[0];
  let destIdentificado = false;
  let destNome = '', destDoc = '';
  if (destBlock) {
    destNome = destBlock.getElementsByTagName('xNome')[0]?.textContent?.trim() || '';
    destDoc = formatDocLocal(
      destBlock.getElementsByTagName('CNPJ')[0]?.textContent ||
      destBlock.getElementsByTagName('CPF')[0]?.textContent
    );
    if (destDoc) destIdentificado = true;
  }

  // --- Totais ---
  const vProdTot = formatMoney(getTotalValue('vProd'));
  const vDesc = formatMoney(getTotalValue('vDesc'));
  const vFrete = formatMoney(getTotalValue('vFrete'));
