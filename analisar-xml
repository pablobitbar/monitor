        <img src="https://api.qrserver.com/v1/create-qr-code/?size=140x140&data=${encodeURIComponent(qrCodeUrl)}" alt="QR Code" style="width: 140px; height: 140px;" />
      ` : `
        <div style="border: 1px solid #000; width: 130px; height: 130px; margin: 0 auto; display: flex; align-items: center; justify-content: center; font-size: 10px; font-style: italic;">
