      '0':'0 - REMETENTE (CIF)','1':'1 - DESTINATÁRIO (FOB)','2':'2 - TERCEIROS',
      '3':'3 - PROPRIO REMET.','4':'4 - PROPRIO DEST.','9':'9 - SEM FRETE'
