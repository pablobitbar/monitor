function abrirVisualizador(idx) {
  if (idx < 0 || idx >= notasFiltradas.length) return;
  indiceVisualizando = idx;
  modal.classList.add('show');
  document.body.style.overflow = 'hidden';
  renderizarNotaAtual();
}

function fecharVisualizador() {
  modal.classList.remove('show');
  document.body.style.overflow = '';
  indiceVisualizando = -1;
  viewerPaper.innerHTML = '';
  viewerPaper.classList.remove('nfce-paper','nfe-paper');
}

function renderizarNotaAtual() {
  if (indiceVisualizando < 0 || indiceVisualizando >= notasFiltradas.length) return;
  const n = notasFiltradas[indiceVisualizando];

  modalTitulo.textContent = `${n.modelo === '55' ? 'NF-e' : 'NFC-e'} — Nº ${n.nNF} / Série ${n.serie}`;
  modalInfo.textContent = `${indiceVisualizando + 1} de ${notasFiltradas.length} • ${n.xNome}`;

  // Reset classes e aplica a correta
  viewerPaper.classList.remove('nfce-paper','nfe-paper');

  try {
    if (n.modelo === '55') {
      viewerPaper.classList.add('nfe-paper');
      viewerPaper.innerHTML = renderNFe(n.xml);
    } else {
      viewerPaper.classList.add('nfce-paper');
      viewerPaper.innerHTML = renderNFCe(n.xml);
    }
  } catch (e) {
    console.error(e);
    viewerPaper.innerHTML = `<div class="empty"><div class="icon">⚠️</div><div>Erro ao renderizar esta nota</div></div>`;
  }

  btnPrev.disabled = indiceVisualizando <= 0;
  btnNext.disabled = indiceVisualizando >= notasFiltradas.length - 1;
  modal.querySelector('.modal-body').scrollTop = 0;
}

btnPrev.addEventListener('click', () => {
  if (indiceVisualizando > 0) { indiceVisualizando--; renderizarNotaAtual(); }
});
btnNext.addEventListener('click', () => {
  if (indiceVisualizando < notasFiltradas.length - 1) { indiceVisualizando++; renderizarNotaAtual(); }
});
document.getElementById('btnCloseModal').addEventListener('click', fecharVisualizador);
document.getElementById('btnPrintModal').addEventListener('click', () => window.print());

document.addEventListener('keydown', (e) => {
  if (!modal.classList.contains('show')) return;
  if (e.key === 'Escape') fecharVisualizador();
  if (e.key === 'ArrowLeft') btnPrev.click();
  if (e.key === 'ArrowRight') btnNext.click();
});

/* ==================================================================
   I) EXPORTAR
   ================================================================== */
function exportarPDF() {
  if (!notasFiltradas.length) return toast('⚠️ Nada para exportar');
  window.print();
}

function exportarCSV() {
  if (!notasFiltradas.length) return toast('⚠️ Nada para exportar');
  const head = ['Nº','Série','Modelo','Data','Emitente','CNPJ','indPres','Pagamento',
                'Taxa Entrega','Valor Taxa','Desconto','Valor Total (vNF)',
                'Total Pago (bruto)','Total Pago (líquido)','Troco','Chave'];
  const linhas = notasFiltradas.map(n => [
    n.nNF, n.serie, n.modelo === '55' ? 'NF-e' : 'NFC-e', n.dhEmi, n.xNome, n.cnpj,
    (n.indPres||'') + ' - ' + (IND_PRES[n.indPres]||''),
    n.tiposPag.map(t => T_PAG[t]||t).join(' | '),
    n.temTaxa ? 'Sim' : 'Não',
    n.valorTaxa.toFixed(2).replace('.',','),
    n.vDesc.toFixed(2).replace('.',','),
    n.vNF.toFixed(2).replace('.',','),
    n.totalPagoBruto.toFixed(2).replace('.',','),
    n.totalPagoLiquido.toFixed(2).replace('.',','),
    n.vTroco.toFixed(2).replace('.',','),
    n.chave
  ]);
  const csv = [head, ...linhas].map(l =>
    l.map(c => `"${String(c??'').replace(/"/g,'""')}"`).join(';')
  ).join('\n');
  const blob = new Blob(['\uFEFF'+csv], {type:'text/csv;charset=utf-8'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'nfe_relatorio.csv';
  a.click();
  toast('⬇️ CSV exportado');
}

/* ==================================================================
   J) TOAST
   ================================================================== */
let toastTimer;
function toast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 3000);
}
</script>
