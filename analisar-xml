   D) RENDERIZADOR NF-e (DANFE A4) — viewer_nfe.js
   ================================================================== */
function renderNFe(xmlText) {
  const parser = new DOMParser();
  const xml = parser.parseFromString(xmlText, 'application/xml');
  if (xml.getElementsByTagName('parsererror').length > 0) {
    return '<div class="empty"><div class="icon">⚠️</div><div>Erro ao ler XML</div></div>';
  }
  const get = (tagName, ctx = xml) => {
    const els = ctx.getElementsByTagName(tagName);
    return els.length > 0 ? els[0].textContent.trim() : '';
  };

  // ---- Emitente (usa contexto do emit para evitar pegar CNPJ do dest) ----
  const emitBlock = xml.getElementsByTagName('emit')[0];
  const xNome = emitBlock?.getElementsByTagName('xNome')[0]?.textContent?.trim() || '---';
  const CNPJ = formatDocLocal(emitBlock?.getElementsByTagName('CNPJ')[0]?.textContent);
  const IE = emitBlock?.getElementsByTagName('IE')[0]?.textContent?.trim() || '---';
  const xLgr = emitBlock?.getElementsByTagName('xLgr')[0]?.textContent?.trim() || '';
  const nro = emitBlock?.getElementsByTagName('nro')[0]?.textContent?.trim() || '';
  const xBairro = emitBlock?.getElementsByTagName('xBairro')[0]?.textContent?.trim() || '';
  const xMun = emitBlock?.getElementsByTagName('xMun')[0]?.textContent?.trim() || '';
  const UF = emitBlock?.getElementsByTagName('UF')[0]?.textContent?.trim() || '';
  const CEP = formatCEP(emitBlock?.getElementsByTagName('CEP')[0]?.textContent);
  const fone = emitBlock?.getElementsByTagName('fone')[0]?.textContent?.trim() || '';

  // ---- Identificação da Nota ----
  const chNFe = get('chNFe') ||
    xml.getElementsByTagName('infNFe')[0]?.getAttribute('Id')?.replace('NFe','') || '';
  const nNF = formatNumeroNota(get('nNF'));
  const serie = get('serie') || '1';
  const tpNF = get('tpNF') || '1';
  const natOp = get('natOp') || '---';
  const nProt = get('nProt') || '---';
  const dhRecbto = formatDataHora(get('dhRecbto'));
  const dhEmi = formatDataHora(get('dhEmi'));
  const dhSaiEntRaw = get('dhSaiEnt');

  let dtSaiEnt = '---';
  let hrSaiEnt = '---';
  if (dhSaiEntRaw) {
    const parts = dhSaiEntRaw.split('T');
    if (parts[0]) {
      const dParts = parts[0].split('-');
      if (dParts.length === 3) dtSaiEnt = `${dParts[2]}/${dParts[1]}/${dParts[0]}`;
    }
    if (parts[1]) hrSaiEnt = parts[1].substring(0, 8);
  }

  // ---- Destinatário ----
  const destBlock = xml.getElementsByTagName('dest')[0];
  let destNome = '---', destCNPJ = '', destIE = 'ISENTO', destLgr = '', destNro = '',
      destBairro = '', destCEP = '', destMun = '', destUF = '';

  if (destBlock) {
    destNome = destBlock.getElementsByTagName('xNome')[0]?.textContent?.trim() || '---';
    destCNPJ = formatDocLocal(
      destBlock.getElementsByTagName('CNPJ')[0]?.textContent ||
      destBlock.getElementsByTagName('CPF')[0]?.textContent
    );
    destIE = destBlock.getElementsByTagName('IE')[0]?.textContent?.trim() || 'ISENTO';
    destLgr = destBlock.getElementsByTagName('xLgr')[0]?.textContent?.trim() || '';
    destNro = destBlock.getElementsByTagName('nro')[0]?.textContent?.trim() || '';
    destBairro = destBlock.getElementsByTagName('xBairro')[0]?.textContent?.trim() || '';
    destCEP = formatCEP(destBlock.getElementsByTagName('CEP')[0]?.textContent);
    destMun = destBlock.getElementsByTagName('xMun')[0]?.textContent?.trim() || '';
    destUF = destBlock.getElementsByTagName('UF')[0]?.textContent?.trim() || '';
  }

  // ---- Impostos (contexto ICMSTot) ----
  const totalBlock = xml.getElementsByTagName('total')[0];
  const icmsTot = totalBlock?.getElementsByTagName('ICMSTot')[0];
  const getTot = (tag) => icmsTot?.getElementsByTagName(tag)[0]?.textContent?.trim() || '0.00';

  const vBC = formatMoney(getTot('vBC'));
  const vICMS = formatMoney(getTot('vICMS'));
  const vBCST = formatMoney(getTot('vBCST'));
  const vST = formatMoney(getTot('vST'));
  const vProdTot = formatMoney(getTot('vProd'));
  const vFrete = formatMoney(getTot('vFrete'));
  const vSeg = formatMoney(getTot('vSeg'));
  const vDesc = formatMoney(getTot('vDesc'));
  const vIPI = formatMoney(getTot('vIPI'));
  const vNF = formatMoney(getTot('vNF'));

  // ---- Transporte ----
  const transpBlock = xml.getElementsByTagName('transp')[0];
  let modFreteText = '9 - SEM FRETE';
