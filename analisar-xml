/* ==================================================================
   E) PARSER XML
   ================================================================== */
function parseXML(xmlString, filename) {
  const parser = new DOMParser();
  const doc = parser.parseFromString(xmlString, 'text/xml');
  if (doc.querySelector('parsererror')) return null;

  const get = (tag, ctx=doc) => ctx.querySelector(tag)?.textContent?.trim() || '';

  const infNFe = doc.querySelector('infNFe');
  let chave = infNFe?.getAttribute('Id')?.replace('NFe','') || '';
  if (!chave) chave = get('chNFe') || '';

  const nNF = get('nNF');
  const serie = get('serie');
  const dhEmi = get('dhEmi') || get('dEmi');
  const indPres = get('indPres');
  const mod = get('mod') || '65';
  const xNome = doc.querySelector('emit > xNome')?.textContent?.trim() || '';
  const cnpj = doc.querySelector('emit > CNPJ')?.textContent?.trim() || '';

  const vNF = parseFloat(get('vNF')) || 0;
  const vDesc = parseFloat(get('vDesc')) || 0;

  // Pagamentos
  const pagamentos = [];
  let vTroco = 0;
  const pagBlock = doc.querySelector('pag');
  if (pagBlock) {
    pagBlock.querySelectorAll('detPag').forEach(p => {
      const t = p.querySelector('tPag')?.textContent?.trim();
      const v = parseFloat(p.querySelector('vPag')?.textContent || '0') || 0;
      if (t) pagamentos.push({ tPag: t, vPag: v });
    });
    vTroco = parseFloat(pagBlock.querySelector('vTroco')?.textContent || '0') || 0;
  }

  const vPago = pagamentos.reduce((s,p) => s + p.vPag, 0);
  const totalPagoBruto = vPago;
  const totalPagoLiquido = vPago - vTroco;
  const tiposPag = [...new Set(pagamentos.map(p => p.tPag))];

  let temTaxa = false;
  let valorTaxa = 0;
  const produtos = [];
  doc.querySelectorAll('det > prod').forEach(prod => {
    const cProd = prod.querySelector('cProd')?.textContent?.trim();
    const xProd = prod.querySelector('xProd')?.textContent?.trim() || '';
    const vProd = parseFloat(prod.querySelector('vProd')?.textContent || '0') || 0;
    produtos.push({ cProd, xProd, vProd });
    if (cProd === '9998' || /taxa\s*de\s*entrega/i.test(xProd)) {
      temTaxa = true;
      valorTaxa += vProd;
    }
  });

  return {
    arquivo: filename, xml: xmlString, modelo: mod,
    chave, nNF, serie, dhEmi, indPres, xNome, cnpj,
    vNF, vDesc, vTroco,
    vPago, totalPagoBruto, totalPagoLiquido,
    pagamentos, tiposPag,
    temTaxa, valorTaxa, produtos,
    data: dhEmi ? new Date(dhEmi) : null
  };
}

