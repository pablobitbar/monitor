      transpNome = transporta.getElementsByTagName('xNome')[0]?.textContent?.trim() || '---';
      transpCNPJ = formatDocLocal(
        transporta.getElementsByTagName('CNPJ')[0]?.textContent ||
        transporta.getElementsByTagName('CPF')[0]?.textContent
